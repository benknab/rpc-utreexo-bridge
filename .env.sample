# Native bridge settings. Leave unused settings commented out.
# DATA_DIR=/path/to/fresh/bridge-data
# P2P_HOST=0.0.0.0
# P2P_PORT=8333
# API_HOST=127.0.0.1:3000
# BITCOIN_CORE_RPC_URL=http://127.0.0.1:8332
# BITCOIN_CORE_COOKIE_FILE=/path/to/bitcoin/.cookie
# Alternatively, set both RPC credentials:
# BITCOIN_CORE_RPC_USER=bridge
# BITCOIN_CORE_RPC_PASSWORD=replace-me
# Verified HTTPS RPC URLs are supported.
# With --features esplora:
# ESPLORA_URL=https://blockstream.info/api

# Docker Compose settings. Core and bridge use the same chain selection.
# BITCOIN_CHAIN=signet
# API_PORT=8080
# P2P_PORT=38333
# PROOF_RETENTION=288
# CHECKPOINT_INTERVAL=1000
